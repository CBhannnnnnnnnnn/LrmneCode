# ---------- 虚拟环境 ----------
.venv/
venv/
env/
ENV/

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/extensions.json
.idea/
.cursor/

# ---------- 工具运行时产物（工作区级，不入库）----------
