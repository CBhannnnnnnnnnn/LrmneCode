.coverage
.coverage.*
coverage.xml
htmlcov/

# ---------- 本地配置（可能含 API Key，绝不入库）----------
settings.json

# ---------- 操作系统杂项 ----------
.DS_Store
Thumbs.db
Desktop.ini

